# Variáveis públicas (visíveis no navegador). Usadas apenas nas rotas /app/*.
# A demonstração (/demonstracao, /loja/*, /admin) funciona 100% local via IndexedDB e não usa estas variáveis.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_publica
# Web Push: chave PÚBLICA VAPID (mesma de VAPID_PUBLIC_KEY). Gerar par novo por ambiente.
VITE_VAPID_PUBLIC_KEY=

# Segredos de servidor — NUNCA prefixar com VITE_ nem versionar.
# Configurar em `supabase secrets set` (Edge Functions) e apenas em `.env.local` ignorado pelo Git para scripts locais:
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_SECRET_KEY=
# INFINITEPAY_HANDLE=
# APP_URL=https://pistec.vercel.app
# APP_ORIGINS=https://pistec.vercel.app,http://localhost:5173,http://127.0.0.1:5173
# BILLING_ENABLED=true
# BILLING_WEBHOOK_TOKEN=
# WORKER_TOKEN=
# AI_ENABLED=true
# GEMINI_API_KEY=
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# RESEND_API_KEY=            # chave "sending access" basta
# EMAIL_FROM=PISTEC <nao-responda@seu-dominio-verificado>   # sem isto os e-mails ficam na fila
# RESEND_WEBHOOK_SECRET=whsec_...                           # webhook → /functions/v1/email-webhook
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@seu-dominio
# Worker: URL e token também no Vault (ver supabase/migrations/20261026000200_schedules.sql).
